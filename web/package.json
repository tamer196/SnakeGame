{
  "name": "neon-serpent",
  "version": "2.0.0",
  "description": "NEON SERPENT - a touch and mouse driven arcade snake game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node tools/verify.mjs dist",
    "verify:device": "node tools/device-verify.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
